# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 저장소에 올라가지 않습니다.

# OpenAI API 키. 없으면 모의 응답 모드로 돕니다.
OPENAI_API_KEY=

# 모델 (선택) — 비워 두면 아래 기본값을 씁니다.
# 단계 판정과 일반 답변은 저렴한 모델, 완성 코드(S3)만 고급 모델을 씁니다.
MODEL_JUDGE=gpt-4o-mini
MODEL_FAST=gpt-4o-mini
MODEL_STD=gpt-4o-mini
MODEL_DEEP=gpt-4o

# 접속 제한 (선택)
# ACCESS_CODE  수업용 공통 접속 코드. 비워 두면 제한하지 않습니다.
# TEAM_CODES   허용 팀 코드 목록(쉼표 구분). 비워 두면 아무 팀 코드나 받습니다.
# ADMIN_KEY    /admin/export 로 기록을 내려받을 때 쓰는 열쇠.
ACCESS_CODE=
TEAM_CODES=
ADMIN_KEY=
